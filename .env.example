# Copia este ficheiro para .env e preenche os valores.
# O .env NUNCA vai para o Git.

# --- Aplicação ---
APP_NAME="Machamba IA"
ENVIRONMENT=development      # development | production
LOG_LEVEL=INFO

# --- Limites de confiança do diagnóstico por foto ---
# >= HIGH: responde normalmente
# entre LOW e HIGH: responde com cautela e pede outra foto
# < LOW: não diagnostica e encaminha para o técnico
VISION_HIGH_CONFIDENCE=0.80
VISION_LOW_CONFIDENCE=0.50

# --- Modelo de visão (ficheiros gerados pelo notebook; relativos à pasta do projecto) ---
MODEL_PATH=models/machamba_efficientnet_b0.pt
LABELS_PATH=models/labels.json
MAX_UPLOAD_MB=8

# --- Filtro de entrada CLIP ("é milho, mandioca, caju ou tomate?") ---
# Desligado ou sem conseguir carregar = todos os diagnósticos vão para o técnico.
# Na primeira vez, os pesos (~600 MB) são descarregados para CLIP_CACHE_DIR.
CLIP_ENABLED=true
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=datacomp_xl_s13b_b90k
# Pontuação mínima (0–1) para aceitar a foto. Afinar com: python scripts/avaliar_filtro.py
CLIP_MIN_SCORE=0.50
CLIP_CACHE_DIR=models/clip

# --- RAG: semelhança mínima para responder ---
RAG_MIN_SIMILARITY=0.80

# --- Segredos (serão necessários em fases futuras) ---
# ANTHROPIC_API_KEY=         # Fase 3
# TELEGRAM_BOT_TOKEN=        # Fase 4
# DASHBOARD_PASSWORD=        # Fase 5
